# ==========================================================================
#  SANTA PSİKOLOJİ: ORTAM DEĞİŞKENLERİ
#  Bu dosya örnektir (değer içermez); gerçek değerleri .env dosyasına yazın. Vercel > Settings > Environment
#  Variables > "Import .env" ile tamamını yapıştırabilirsiniz.
#
#  [SECRET] = gizli: kimseyle paylaşmayın, repoya koymayın, sohbete yapıştırmayın.
#  [CONFIG] = ayar: gizli değil (yine de herkese açık bir yere yazmayın).
#  [OPSİYONEL] = boş bırakılabilir, o özellik kapalı kalır.
# ==========================================================================


# ---- 1) YÖNETİM PANELİ (/panel girişi) -----------------------------------

# [CONFIG] Panel kullanıcı adı
PANEL_USER=

# [SECRET] Panel şifresi. Canlıya geçerken güçlü, yeni bir şifreyle değiştirin.
PANEL_PASS=

# [SECRET] Oturum çerezlerini imzalayan gizli anahtar. En az 32 karakter, rastgele.
# Üretmek için terminalde:  openssl rand -hex 32
# Değiştirirseniz açık tüm panel oturumları kapanır.
PANEL_SECRET=


# ---- 2) VERİTABANI (Postgres) ---------------------------------------------
# İçerik, mesajlar, ayarlar ve düzenlemeler burada saklanır.
# Vercel'de en kolayı: Storage / Marketplace > Neon (Postgres) bağla;
# DATABASE_URL otomatik eklenir. Başka bir Postgres (Supabase vb.) de olur.
# Boşsa yerelde data/ klasörü kullanılır; CANLIDA BOŞ BIRAKMAYIN.

# [SECRET] Bağlantı adresi (kullanıcı adı ve şifre içerir)
# Örnek: postgresql://kullanici:sifre@host/veritabani?sslmode=require
DATABASE_URL=


# ---- 3) GÖRSEL YÜKLEME (Cloudinary) ---------------------------------------
# cloudinary.com > Dashboard > "API Keys" bölümünden alınır.
# Boşsa yerelde data/uploads klasörü kullanılır; CANLIDA BOŞ BIRAKMAYIN.

# [CONFIG] Cloud name (Dashboard'un üstünde yazar)
CLOUDINARY_CLOUD_NAME=

# [SECRET] API key
CLOUDINARY_API_KEY=

# [SECRET] API secret
CLOUDINARY_API_SECRET=

# [CONFIG] Görsellerin toplanacağı klasör (isterseniz değiştirmeyin)
CLOUDINARY_FOLDER=santa-psikoloji


# ---- 4) SİTE ADRESİ ---------------------------------------------------------

# [CONFIG] Sitenin canlı adresi: canonical, sitemap ve paylaşım görselleri için.
# Sonunda / olmasın. Alan adı bağlanınca güncelleyin.
SITE_URL=https://www.santapsikoloji.com


# ---- 5) E-POSTA BİLDİRİMİ: yeni mesaj gelince mail atar [OPSİYONEL] ---------
# resend.com > API Keys. Alan adı doğrulamadan göndermek için MAIL_FROM'u boş bırakın
# (onboarding@resend.dev kullanılır, yalnızca Resend hesabınızın e-postasına gider).

# [SECRET] Resend API key
RESEND_API_KEY=

# [CONFIG] Bildirimin gideceği adres(ler); birden çoksa virgülle ayırın
NOTIFY_EMAIL=

# [CONFIG] Gönderen. Örn: Santa Psikoloji <bildirim@santapsikoloji.com> (alan adı Resend'de doğrulanmış olmalı)
MAIL_FROM=
